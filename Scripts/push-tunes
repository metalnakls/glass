#!/usr/bin/env python3
"""Publish only saved appearance data; never checks out or pushes main."""
import argparse
import json
import math
import pathlib
import subprocess
import tempfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
SOURCE = ROOT / 'Sources/GlassRemoteUI/Resources/AppearanceDefaults.json'


def git(*args, cwd=None):
    return subprocess.check_output(['git', *args], cwd=cwd or ROOT, text=True).strip()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--check', action='store_true', help='Validate only; no network or push')
    args = parser.parse_args()
    data = SOURCE.read_bytes()
    values = json.loads(data)
    if not isinstance(values, dict) or not values or len(data) > 65536:
        raise ValueError('Invalid tuning config')
    for key, value in values.items():
        if not key.startswith('GlassList.') and key not in ('GlassWindow.defaultWidth', 'GlassWindow.defaultHeight'):
            raise ValueError('Config must contain appearance settings only')
        if key.startswith('GlassWindow.'):
            minimum = 680 if key.endswith('Width') else 260
            if isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value) and minimum <= value <= 16384:
                continue
            raise ValueError(f'Invalid window dimension: {key}')
        if isinstance(value, bool):
            continue
        if isinstance(value, (int, float)) and math.isfinite(value) and (-80 if key == "GlassList.highlightWidth" else -10) <= value <= 240:
            continue
        if isinstance(value, str) and len(value) == 6 and all(c in '0123456789abcdefABCDEF' for c in value):
            continue
        raise ValueError(f'Invalid appearance value: {key}')
    if args.check:
        print('Tuning config valid. No push performed.')
        return
    remote = git('remote', 'get-url', '--push', 'origin')
    head = git('ls-remote', '--heads', remote, 'refs/heads/tunes')
    with tempfile.TemporaryDirectory(prefix='glass-tunes-') as directory:
        repo = pathlib.Path(directory)
        git('init', '--quiet', cwd=repo)
        # Reuse identity without modifying the user's checkout or configuration.
        for field in ('user.name', 'user.email'):
            git('config', field, git('config', field), cwd=repo)
        if head:
            git('fetch', '--quiet', remote, 'refs/heads/tunes', cwd=repo)
            git('checkout', '--quiet', '-b', 'tunes', 'FETCH_HEAD', cwd=repo)
        else:
            git('checkout', '--quiet', '--orphan', 'tunes', cwd=repo)
        (repo / 'AppearanceDefaults.json').write_bytes(data)
        git('add', 'AppearanceDefaults.json', cwd=repo)
        if not git('diff', '--cached', '--name-only', cwd=repo):
            print('Published tuning already matches. Nothing pushed.')
            return
        git('commit', '--quiet', '-m', 'tunes', cwd=repo)
        # No force: concurrent publishers must fetch and retry, never overwrite history.
        git('push', remote, 'HEAD:refs/heads/tunes', cwd=repo)
    print('Published appearance config only. No app release created.')


if __name__ == '__main__':
    main()
