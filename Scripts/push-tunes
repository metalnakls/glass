#!/usr/bin/env python3
"""Publish saved appearance data on main without creating an app release."""
import argparse
import json
import math
import pathlib
import subprocess
import datetime
import time
from zoneinfo import ZoneInfo

ROOT = pathlib.Path(__file__).resolve().parent.parent
SOURCE = ROOT / 'Sources/GlassRemoteUI/Resources/AppearanceDefaults.json'


def git(*args, cwd=None):
    return subprocess.check_output(['git', *args], cwd=cwd or ROOT, text=True).strip()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--check', action='store_true', help='Validate only; no network or push')
    args = parser.parse_args()
    data = SOURCE.read_bytes()
    values = json.loads(data)
    if not isinstance(values, dict) or not values or len(data) > 65536:
        raise ValueError('Invalid tuning config')
    for key, value in values.items():
        if not key.startswith('GlassList.') and key not in ('GlassWindow.defaultWidth', 'GlassWindow.defaultHeight'):
            raise ValueError('Config must contain appearance settings only')
        if key.startswith('GlassWindow.'):
            minimum = 680 if key.endswith('Width') else 260
            if isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value) and minimum <= value <= 16384:
                continue
            raise ValueError(f'Invalid window dimension: {key}')
        if isinstance(value, bool):
            continue
        if isinstance(value, (int, float)) and math.isfinite(value) and (-80 if key == "GlassList.highlightWidth" else -10) <= value <= 240:
            continue
        if isinstance(value, str) and len(value) == 6 and all(c in '0123456789abcdefABCDEF' for c in value):
            continue
        raise ValueError(f'Invalid appearance value: {key}')
    if args.check:
        print('Tuning config valid. No push performed.')
        return
    if git('branch', '--show-current') != 'main':
        raise ValueError('Switch to main before publishing tuning')
    git('fetch', '--quiet', 'origin', 'main')
    if git('rev-parse', 'HEAD') != git('rev-parse', 'FETCH_HEAD'):
        raise ValueError('Synchronize main first; tuning publication will not push unrelated commits')
    relative = str(SOURCE.relative_to(ROOT))
    if not git('diff', 'HEAD', '--', relative):
        print('Published tuning already matches. Nothing pushed.')
        return
    while True:
        now = datetime.datetime.now(ZoneInfo('Europe/Moscow'))
        if now.minute % 2 == 0 and now.minute not in (30, 50) and now.second <= 10:
            break
        time.sleep(1)
    # --only leaves unrelated staged and working-tree changes untouched.
    git('commit', '--quiet', '--only', '-m', 'Tune', '--', relative)
    git('push', 'origin', 'HEAD:refs/heads/main')
    print('Published appearance config on main. No app release created.')


if __name__ == '__main__':
    main()
